# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite

# Groq Fallback AI Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,groq/compound-mini

# Brave Search API Configuration
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Adzuna API Configuration
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in

# RapidAPI Configuration (Centralized + optional provider overrides)
RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_JSEARCH_KEY=your-jsearch-specific-key

# Job Search Settings
JOB_SEARCH_CACHE_TTL_SECONDS=300
JOB_SEARCH_DEFAULT_MODE=sequential

# Application Automation
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
# PLAYWRIGHT_BROWSERS_PATH=/path/to/playwright-browsers (optional, for OCI deployment)

# Browserbase Fallback Automation Engine
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-project-id
MAX_BROWSERBASE_CONCURRENCY=2

